{
  "name": "dsh-rea-local-inspection",
  "version": "1.0.0",
  "private": true,
  "description": "Read the metadata of local binaries, Android packages and model files using REA's parsers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averyjohnkucan-arch/rea.git"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "static-analysis"],
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "inspection.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@msgpack/msgpack": "3.1.3",
    "@zip.js/zip.js": "2.15.0",
    "canonicalize": "3.0.0",
    "lossless-json": "4.3.1",
    "stream-chain": "4.2.6",
    "stream-json": "3.7.0",
    "zod": "4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
